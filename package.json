{
  "name": "auth-mini-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:bundle": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply auth-mini --local",
    "db:migrate:remote": "wrangler d1 migrations apply auth-mini --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.152.0",
    "yaml": "2.8.3"
  }
}
