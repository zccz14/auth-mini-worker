{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auth-mini-worker",
  "main": "src/index.ts",
  // Keep this pinned: auth-mini-rs must stay on a compatibility_date that
  // reproduces the runtime semantics our contract tests were written against.
  "compatibility_date": "2026-10-25",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "auth-mini",
      "database_id": "86c6dcd6-4c00-413e-b695-aec3b4cb9b98",
      "migrations_dir": "migrations"
    }
  ],
  // The GUI is served from the same origin as the API, because WebAuthn's rp_id is this host:
  // no other hostname can run the passkey ceremony for auth.ntnl.io.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    // Every request goes through src/index.ts, which serves /web/* itself, so unknown API paths
    // still answer JSON 404 instead of the SPA shell.
    "run_worker_first": true
  }
}
